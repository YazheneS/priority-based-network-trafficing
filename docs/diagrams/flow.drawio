<mxfile host="app.diagrams.net">
  <diagram name="Classification Flow" id="flow1">
    <mxGraphModel dx="1000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s1" value="Packet arrives on s1-eth1/2/3&#10;NIC offloads (TSO/GSO/GRO) must be off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="20" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Group into flow (5-tuple) window&#10;drop TCP control packets: len(tcp.payload)==0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="190" y="120" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Window of 20 packets reached?&#10;timestamps use float(pkt.time), not time.time()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="190" y="220" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="compute_features() - six features&#10;mean_size, std_size, mean_iat, std_iat,&#10;burstiness = std_size/mean_size,&#10;byte_rate = total_bytes / window_duration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6DFF7;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="320" width="460" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Trained model loaded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDE2E2;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="440" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s6a" value="Decision tree (depth 4)&#10;model.real.joblib, 6-feature vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F2E6;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="570" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6b" value="Rule-based fallback&#10;mean_size/burstiness/mean_iat thresholds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="570" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="Tier: realtime | besteffort | bulk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="670" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="bridge.py POSTs /classify to controller&#10;{dpid, tier, src_ip, dst_ip, src_port, dst_port, ip_proto}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE2E2;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="190" y="755" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="priority_engine_on?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D9F2E6;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="845" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="Install OpenFlow rule&#10;priority 25, SetQueue(0/1/2) + NORMAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F2E6;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="False: OFPActionOutput(NORMAL) only, no queue set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="930" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="no, keep collecting" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s5" target="s6a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s5" target="s6b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s6a" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s6b" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" value="True" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f13" value="False" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s9" target="s11"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
