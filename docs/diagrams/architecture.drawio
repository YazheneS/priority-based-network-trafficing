<mxfile host="app.diagrams.net">
  <diagram name="System Architecture" id="arch1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="hosts" value="Mininet Hosts&#10;h1 realtime (UDP:5000)&#10;h2 besteffort&#10;h3 bulk (TCP:5201)&#10;h4 receiver (10.0.0.4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ovs" value="Open vSwitch s1&#10;OpenFlow 1.3&#10;HTB queues Q0/Q1/Q2&#10;bottleneck s1-eth4 (10 Mbps)&#10;topology/setup_queues.sh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="295" y="40" width="210" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ctrl" value="os-ken Controller&#10;controller/priority_controller.py&#10;REST :8080 - /classify /toggle /status&#10;installs set_queue rules (prio 25&gt;20&gt;5)&#10;OpenFlow 1.3 @ 127.0.0.1:6653" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F2E6;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="650" y="40" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="bridge" value="Integration Bridge + Classifier&#10;(one process: integration/bridge.py&#10;calls classifier/traffic_classifier.py)&#10;sniffs s1-eth1..3 - 6-feature window&#10;decision tree (depth 4) + rule fallback&#10;writes metrics_store.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE2E2;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="650" y="240" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="metrics" value="metrics_store.json&#10;per-flow events: tier,&#10;features, jitter_estimate_ms&#10;+ controller_status&#10;(polled every 2s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="backend" value="Dashboard Backend&#10;dashboard/backend/server.js&#10;Node/Express, port 4000&#10;watches file (chokidar) -&gt; WS /ws&#10;POST /api/toggle -&gt; proxies /toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="240" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="frontend" value="Dashboard Frontend&#10;React App.jsx&#10;jitter chart,&#10;ON/OFF toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="110" height="110" as="geometry" />
        </mxCell>

        <mxCell id="harness" value="Experiment Harness&#10;automation/run_all.sh&#10;3 trials x 15s, engine OFF/ON&#10;eval_classifier.py (holdout accuracy)&#10;-&gt; results/table1_*.csv, *.png" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="450" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="report" value="Final Report (docs/)&#10;main.tex (IEEE) \input's&#10;implementation_section.tex&#10;reads results/*.png, cites refs.bib" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="650" y="450" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="data traffic" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hosts" target="ovs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="OpenFlow 1.3 / set_queue" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ovs" target="ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="passive sniff (s1-eth1..3)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ovs" target="bridge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="POST /classify {dpid,tier,...} / GET /status" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="bridge" target="ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="bridge" target="metrics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="file watch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="metrics" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="WS /ws" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="backend" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="POST /api/toggle" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="frontend" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="proxies to POST /toggle" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="backend" target="ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="starts topo.py, iperf3, toggles engine directly" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="harness" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="writes results/" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="harness" target="report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="accuracy, figures" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="report" target="bridge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
